MONGODB_URI=mongodb://127.0.0.1:27018/pharmalink_demo?replicaSet=rs0
# Required, at least 32 characters. Replace this placeholder using:
# openssl rand -base64 32
# A short or guessable secret lets anyone forge tokens for any account, so
# the server refuses to start below that length.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Access-token lifetime.
JWT_EXPIRES_IN=24h
# Idle refresh-token lifetime in days.
REFRESH_TOKEN_TTL_DAYS=30
PORT=5000
NODE_ENV=development
# Comma-separated browser origins allowed by the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# SMS_PROVIDER=console logs OTPs to the backend console. Current login uses
# phone + password; OTP delivery is optional and is not needed for the demo.
SMS_PROVIDER=console
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

# Optional Firebase Admin push credentials. Leave blank to disable push.
# If configured, use either the external service-account file path or all
# three individual credential values; never commit the service-account file.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Optional Cloudflare R2 credentials for object storage.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Optional Cloudinary uploads. Leave blank for local demos; upload-dependent
# endpoints return IMAGE_UPLOADS_UNAVAILABLE and clients show their placeholder.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional image-provider API key; leave blank when unused.
IMAGE_API_KEY=

# Optional notification diagnostics; keep false for normal demos.
NOTIFICATION_DEBUG=false

# Test-only knobs (do not enable in a normal demo):
# DISABLE_AUTH_RATE_LIMIT=1
# MONGOMS_LAUNCH_TIMEOUT=120000

# Optional local replica-set helper overrides:
# DEV_REPLSET_PORT=27018
# DEV_REPLSET_DBPATH=<user-writable-directory>
# MONGOD_PATH=<path-to-mongod>
