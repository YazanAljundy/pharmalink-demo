# Backend HTTP API (Express).
VITE_API_BASE_URL=http://localhost:5000/api
# Backend origin for the Socket.IO connection.
VITE_SOCKET_URL=http://localhost:5000
# Set to false to hide the demo badge from both dashboard headers.
VITE_SHOW_DEMO_BADGE=true
# Default true: use bundled demo data without HTTP, Socket.IO, or internet.
# Set to false to connect to the configured local backend.
VITE_DEMO_MOCK_API=true
